<Window x:Class="WeatherWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="날씨 위젯" Width="364" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="{StaticResource UiFont}" Foreground="White"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Sep" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="Margin" Value="0,12"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="PmBox" TargetType="Border">
            <Setter Property="Background" Value="#0FFFFFFF"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>
    </Window.Resources>

    <Border x:Name="RootPanel" Margin="12" CornerRadius="18" Padding="20,18,20,16"
            Background="#8C10141E" BorderBrush="#2EFFFFFF" BorderThickness="1"
            MouseLeftButtonDown="RootPanel_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <!-- 시계 -->
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ClockText" Text="00:00" FontSize="64" FontWeight="SemiBold"/>
                <TextBlock x:Name="SecText" Text=":00" FontSize="22" FontWeight="SemiBold" Opacity="0.6" Margin="4,0,0,10" VerticalAlignment="Bottom"/>
            </StackPanel>
            <TextBlock x:Name="DateText" FontSize="15" Opacity="0.8" Margin="0,2,0,0"/>

            <Border Style="{StaticResource Sep}"/>

            <!-- 현재 날씨 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ContentControl x:Name="NowIcon" Width="58" Height="58" VerticalAlignment="Center"/>
                <TextBlock x:Name="TempText" Grid.Column="1" Text="--°" FontSize="44" FontWeight="Light"
                           VerticalAlignment="Center" Margin="10,0,12,0"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="DescText" Text="불러오는 중…" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SubText" FontSize="13" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="LocText" FontSize="13" Opacity="0.85" HorizontalAlignment="Right" Margin="0,2,0,0"/>

            <UniformGrid x:Name="StatsGrid" Columns="3" Margin="0,10,0,0"/>

            <!-- 일별 예보 -->
            <Border Style="{StaticResource Sep}"/>
            <TextBlock x:Name="DaysLabel" Text="일별 예보" Style="{StaticResource Label}"/>
            <StackPanel x:Name="DayList"/>

            <!-- 미세먼지 -->
            <Border Style="{StaticResource Sep}"/>
            <TextBlock Text="미세먼지" Style="{StaticResource Label}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource PmBox}">
                    <DockPanel>
                        <TextBlock Text="미세먼지" FontSize="12" VerticalAlignment="Center"/>
                        <ContentControl x:Name="Pm10Badge" HorizontalAlignment="Right"/>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource PmBox}">
                    <DockPanel>
                        <TextBlock Text="초미세" FontSize="12" VerticalAlignment="Center"/>
                        <ContentControl x:Name="Pm25Badge" HorizontalAlignment="Right"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- 시간별 -->
            <Border Style="{StaticResource Sep}"/>
            <TextBlock Text="시간별 (2시간 간격)" Style="{StaticResource Label}"/>
            <UniformGrid x:Name="HourGrid" Columns="5"/>
        </StackPanel>
    </Border>
</Window>
